{
  "reactSnap": {
    "source": "output/wwwroot",
    "include": [
      "/",
      "/card/experience",
      "/card/education",
      "/card/projects",
      "/card/projects/mcp-builder",
      "/card/projects/portfolio-website",
      "/card/projects/pestilence-game",
      "/card/projects/safe-routes-to-school-vr-app",
      "/card/projects/spacecraft-game",
      "/card/projects/traversial-game"
    ],
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-extensions",
      "--disable-gpu"
    ],
    "puppeteerExecutablePath": null,
    "headless": true,
    "waitFor": 6000,
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "fixWebpackChunksIssue": false,
    "fixInsertRule": true,
    "externalServer": false,
    "skipThirdPartyRequests": true,
    "cacheAjaxRequests": false,
    "preconnectThirdParty": false
  }
}